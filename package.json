{
  "name": "bakery-traceability",
  "version": "0.1.0",
  "private": true,
  "description": "Lot traceability for a small bakery: Supabase, Next.js, and (next) an MCP server.",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > lib/database.types.ts",
    "db:users": "tsx --env-file=.env.local scripts/create-dev-users.ts",
    "docker:up": "docker compose --env-file .env.local up --build -d",
    "docker:down": "docker compose --env-file .env.local down"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "supabase": "^2.120.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.7"
  }
}
