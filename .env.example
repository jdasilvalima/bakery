# Copy to .env.local. For local Supabase, take the values from:
#   npx supabase status -o env   (API_URL, PUBLISHABLE_KEY, SECRET_KEY)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
# Only used by scripts/create-dev-users.ts, never by the app.
SUPABASE_SECRET_KEY=
BAKERY_TIME_ZONE=America/New_York
# Password for the local dev accounts (owner@bakery.test, manager@bakery.test, operator@bakery.test)
DEV_USER_PASSWORD=
